{
  "manifest_version": 3,
  "name": "Warframe Account ID Grabber",
  "version": "1.0.1",
  "description": "Easily lets you know what your Warframe account ID is.",
  "permissions": ["cookies"],
  "host_permissions": ["https://www.warframe.com/*"],
  "action": {
    "default_title": "Warframe Account ID Grabber",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{86ca0a81-77d0-493b-ae35-491aeb937761}",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
